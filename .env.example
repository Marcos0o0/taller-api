# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://mongo:27017/taller
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=tu-clave-de-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo
SMTP_PASS=tu-clave-de-aplicacion

# Frontend
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_PUBLIC_MAX=10
RATE_LIMIT_PUBLIC_WINDOW=3600000
RATE_LIMIT_ADMIN_MAX=1000
RATE_LIMIT_ADMIN_WINDOW=3600000
RATE_LIMIT_MECHANIC_MAX=500
RATE_LIMIT_MECHANIC_WINDOW=3600000

# Cache TTL (segundos)
CACHE_TTL_DEFAULT=300
CACHE_TTL_CLIENTS=600
CACHE_TTL_QUOTES=180
CACHE_TTL_ORDERS=120

# Email Retry
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAYS=0,300000,900000
EMAIL_TIMEOUT=10000

# Workshop Info
WORKSHOP_NAME=nombre-de-taller
WORKSHOP_EMAIL=contacto@taller.com
WORKSHOP_PHONE=tu-numero
WORKSHOP_ADDRESS=tu-direccion